                "packages": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{cuentas}}/auth/registro",
              "host": [
                "{{cuentas}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "description": "Crea la cuenta de prueba. La segunda vez responde 409 EMAIL_YA_REGISTRADO, que también se da por bueno para poder correr la colección varias veces.",
