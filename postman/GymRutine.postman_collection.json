          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201, 409', () => pm.expect([201, 409]).to.include(pm.response.code))",
                  "if (pm.response.code < 300) {",
                  "  pm.environment.set('token', pm.response.json().token)",
                  "}"
